        "import features, importlib\n",
        "\n",
        "new_code = '''import pandas as pd\n",
        "\n",
        "PROPERTY_TYPES = [\"Condo Apt\", \"Detached\", \"Semi-Detached\", \"Condo Townhouse\",\n",
        "                  \"Freehold Townhouse\", \"Co-Op Apt\"]\n",
        "\n",
        "GOOD_WORDS = [\"redone\", \"turnkey\", \"updated\", \"newer\", \"modern\", \"fresh\", \"cared\", \"custom\"]\n",
        "BAD_WORDS = [\"needs\", \"potential\", \"opportunity\", \"bones\", \"original\", \"older\", \"vision\"]\n",
        "\n",
        "\n",
        "def square_feet(house_area):\n",
        "    parts = house_area.astype(str).str.split(\"-\", expand=True).reindex(columns=[0, 1])\n",
        "    low = pd.to_numeric(parts[0], errors=\"coerce\")\n",
        "    high = pd.to_numeric(parts[1], errors=\"coerce\").fillna(low)\n",
        "    return (low + high) / 2\n",
        "\n",
        "\n",
        "def keyword_counts(remarks):\n",
        "    text = remarks.fillna(\"\").astype(str).str.lower()\n",
        "    good = sum(text.str.contains(w, regex=False).astype(int) for w in GOOD_WORDS)\n",
        "    bad = sum(text.str.contains(w, regex=False).astype(int) for w in BAD_WORDS)\n",
        "    return good, bad\n",
        "\n",
        "\n",
        "def off_market_features(homes):\n",
        "    X = pd.DataFrame(index=homes.index)\n",
        "    X[\"square_feet\"] = square_feet(homes[\"house_area\"])\n",
        "    X[\"bedrooms\"] = homes[\"bedrooms\"]\n",
        "    X[\"washrooms\"] = homes[\"washrooms\"]\n",
        "    X[\"parking\"] = homes[\"parking_total\"]\n",
        "    X[\"lot_size\"] = homes[\"lot_front\"] * homes[\"lot_depth\"]\n",
        "    X[\"garage\"] = homes[\"garage\"].astype(str)\n",
        "    X[\"municipality\"] = homes[\"municipality\"].astype(str)\n",
        "    X[\"community\"] = homes[\"community\"].astype(str)\n",
        "    X[\"latitude\"] = homes[\"latitude\"]\n",
        "    X[\"longitude\"] = homes[\"longitude\"]\n",
        "    X[\"months\"] = (homes[\"date_listed\"] - pd.Timestamp(\"2021-01-01\")).dt.days / 30.44\n",
        "    for kind in PROPERTY_TYPES:\n",
        "        X[\"is_\" + kind] = (homes[\"house_type_name\"] == kind).astype(int)\n",
        "    good, bad = keyword_counts(homes[\"remarks\"])\n",
        "    X[\"good_words\"] = good\n",
        "    X[\"bad_words\"] = bad\n",
        "    return X\n",
        "\n",
        "\n",
        "def list_aware_features(homes):\n",
        "    X = off_market_features(homes)\n",
        "    X[\"list_price\"] = homes[\"list_price\"]\n",
        "    return X\n",
        "'''\n",
        "\n",
        "path = features.__file__\n",
        "open(path, \"w\").write(new_code)\n",
        "print(\"Wrote the file to:\", path)\n",
        "\n",
        "import models, run\n",
        "importlib.reload(features)\n",
        "importlib.reload(models)\n",
        "importlib.reload(run)\n",
        "print(\"Contains keyword features:\", \"good_words\" in open(path).read())"
